# MySQL in every environment. Create a separate schema/user for dev, test and prod.
MK_DB_HOST=127.0.0.1
MK_DB_PORT=3306
MK_DB_NAME=mk_quant
MK_DB_USER=mk_quant
MK_DB_PASSWORD=
# Loopback/SSH tunnel: automatic local transport. Remote DB: verify_identity + CA.
# MK_DB_SSL_MODE=verify_identity
MK_DB_SSL_CA=
MK_ARTIFACT_ROOT=artifacts
MK_DEMO=0
MK_DEMO_PASSWORD=
MK_ENABLE_LIVE=0
# Generate once; store outside version control and separately from database backups.
MK_MASTER_KEY=
MK_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MK_COOKIE_SECURE=0
# Only for a dedicated database name ending _test. Never use the production schema.
MK_TEST_ALLOW_RESET=0
MK_BACKTEST_ADDRESS_SPACE_MB=2048
